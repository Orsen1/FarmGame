{
  "name": "FarmGame",
  "tree": {
    "$className": "DataModel",
    "ServerScriptService": {
      "$path": "src/server",
      "$ignoreUnknownInstances": true,
      "ResourceGatherHandler": {
        "$path": "src/places/ResourceWorld/ResourceGatherHandler.server.lua"
      },
      "ResourceSpawnService": {
        "$path": "src/places/ResourceWorld/ResourceSpawnService.lua"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "$ignoreUnknownInstances": true,
      "ResourceTemplates": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "Oak": {"$path": "src/places/ResourceWorld/ResourceNodes/Oak.rbxmx"},
        "Birch": {"$path": "src/places/ResourceWorld/ResourceNodes/Birch.rbxmx"},
        "Stone": {"$path": "src/places/ResourceWorld/ResourceNodes/Stone.rbxmx"},
        "LargeBoulder": {"$path": "src/places/ResourceWorld/ResourceNodes/LargeBoulder.rbxmx"}
      }
    },
    "ReplicatedStorage": {
      "$path": "src/shared",
      "$ignoreUnknownInstances": true
    },
    "StarterPlayer": {
      "$properties": {
        "CharacterWalkSpeed": 20
      },
      "StarterPlayerScripts": {
        "$path": "src/client",
        "$ignoreUnknownInstances": true,
        "ResourceGatherVisual": {
          "$path": "src/places/ResourceWorld/ResourceGatherVisual.client.lua"
        }
      }
    },
    "StarterGui": {
      "$path": "src/gui",
      "$ignoreUnknownInstances": true
    },
    "Workspace": {
      "$path": "src/workspace",
      "$ignoreUnknownInstances": true,
      "ResourceNodes": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      }
    }
  }
}