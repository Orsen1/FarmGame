							<ProtectedString name="Source"><![CDATA[local prompt = script.Parent

local serverScriptService = game:GetService("ServerScriptService")
local PlantService = require(serverScriptService:WaitForChild("PlantService"))

prompt.Triggered:Connect(function(player)
	local gardenBed = prompt.Parent.Parent.Parent

	local inventory = player:FindFirstChild("Inventory")
    local slotNumber = player:GetAttribute("SelectedSlot") or 1
    local slot = inventory and inventory:FindFirstChild("Slot" .. slotNumber)

	if not slot then
        return
    end
	
	local itemName = slot.ItemName.Value

	if itemName == "Shovel" then
        -- Окно подтверждения открывает клиент.
        return
    end

	if gardenBed:GetAttribute("ReadyToHarvest") then
        PlantService.Harvest(player, gardenBed)
        return
    end
	
	if gardenBed:GetAttribute("Occupied") or slot.Amount.Value <= 0 or not itemName:match("Seed$") then
		return
	end

	PlantService.Plant(player, gardenBed, itemName)
end)]]></ProtectedString>
