						<float name="MaxIndicatorDistance">0</float>
						<string name="ObjectText">Garden bed</string>
						<bool name="RequiresLineOfSight">true</bool>
						<Ref name="RootLocalizationTable">null</Ref>
						<token name="Style">0</token>
						<Vector2 name="UIOffset">
							<X>0</X>
							<Y>0</Y>
						</Vector2>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">GardenBedPrompt</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
					<Item class="Script" referent="RBX9EAAEDFFBE1443A2A21A31FB68A93953">
						<Properties>
							<ProtectedString name="Source"><![CDATA[local prompt = script.Parent

local serverScriptService = game:GetService("ServerScriptService")
local PlantService = require(serverScriptService:WaitForChild("PlantService"))

prompt.Triggered:Connect(function(player)
	local gardenBed = prompt.Parent.Parent.Parent

	local inventory = player:FindFirstChild("Inventory")
    local slotNumber = player:GetAttribute("SelectedSlot") or 1
    local slot = inventory and inventory:FindFirstChild("Slot" .. slotNumber)

	if not slot then
        return
    end
	
	local itemName = slot.ItemName.Value

	if itemName == "Shovel" then
        -- Окно подтверждения открывает клиент.
        return
    end

	if gardenBed:GetAttribute("ReadyToHarvest") then
        PlantService.Harvest(player, gardenBed)
        return
    end
	
	if gardenBed:GetAttribute("Occupied") or slot.Amount.Value <= 0 or not itemName:match("Seed$") then
		return
	end

	PlantService.Plant(player, gardenBed, itemName)
end)]]></ProtectedString>
