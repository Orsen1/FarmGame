					<Item class="Script" referent="RBX394FB56E2CF44E7DAAA59A8257D10D32">
						<Properties>
							<ProtectedString name="Source"><![CDATA[local ServerScriptService = game:GetService("ServerScriptService")
local ProductionService = require(ServerScriptService:WaitForChild("ProductionService"))

local prompt = script.Parent
local mill = prompt.Parent.Parent.Parent
local outputInventory = mill:WaitForChild("OutputInventory")

local function updatePrompt()
	local total = 0

	for _, storedItem in ipairs(outputInventory:GetChildren()) do
		if storedItem:IsA("IntValue") and storedItem.Value > 0 then
			total = total + storedItem.Value
		end
	end

	prompt.Enabled = total > 0
	prompt.ActionText = "Collect (" .. total .. ")"
end

local function watchItem(storedItem)
	if storedItem:IsA("IntValue") then
		storedItem.Changed:Connect(updatePrompt)
	end

	updatePrompt()
end

for _, storedItem in ipairs(outputInventory:GetChildren()) do
	watchItem(storedItem)
end

outputInventory.ChildAdded:Connect(watchItem)
outputInventory.ChildRemoved:Connect(updatePrompt)

prompt.Triggered:Connect(function(player)
	local success, message = ProductionService.Collect(player, mill)

	if not success then
		warn("[COLLECT]", message)
	end
end)

updatePrompt()]]></ProtectedString>
