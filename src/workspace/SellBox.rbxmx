					<Properties>
						<ProtectedString name="Source"><![CDATA[local prompt = script.Parent

local replicatedStorage = game:GetService("ReplicatedStorage")
local OpenSellGuiEvent = replicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("OpenSellGuiEvent")

prompt.Triggered:Connect(function(player)
	print("SellBoxPromt triggered")
	OpenSellGuiEvent:FireClient(player)
end)]]></ProtectedString>
