		<Item class="LocalScript" referent="RBXCDEE5E7FF1744744A390F3668D689BF2">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local replicatedStorage = game:GetService("ReplicatedStorage")
local setSelectedSlotEvent = replicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("SetSelectedSlotEvent")

local player = game.Players.LocalPlayer
local inventory = player:WaitForChild("Inventory")
local hotbarFrame = script.Parent:WaitForChild("HotbarFrame")
local UserInputService = game:GetService("UserInputService")
local selectedSlotNumber = 1
local normalColor = Color3.fromRGB(255, 235, 180)
local selectedColor = Color3.fromRGB(220, 180, 110)
local normalStrokeColor = Color3.fromRGB(190, 140, 70)
local selectedStrokeColor = Color3.fromRGB(120, 80, 35)


local function getSelectedItemName()
	local selectedSlot = inventory:FindFirstChild("Slot" .. selectedSlotNumber)

	if not selectedSlot then
		return ""
	end

	return selectedSlot.ItemName.Value
end

local function isSeed(itemName)
	return itemName:match("Seed$") ~= nil
end

local function getIcon(itemName)
	if itemName == "CarrotSeed" then
		return "🌱"
	elseif itemName == "Carrot" then
		return "🥕"
	end

	return ""
end


local function updateSlot(slotData)
	local guiSlot = hotbarFrame:FindFirstChild(slotData.Name)
	if not guiSlot then
		return
	end

	local itemIcon = guiSlot:WaitForChild("ItemIcon")
	local amountText = guiSlot:WaitForChild("AmountText")

	local itemName = slotData.ItemName.Value
	local amount = slotData.Amount.Value

	if itemName == "" or amount <= 0 then
		itemIcon.Text = ""
		amountText.Text = ""
		return
	end

	itemIcon.Text = getIcon(itemName)
	amountText.Text = tostring(amount)
end

local function bindSlot(slotData)
	slotData.ItemName.Changed:Connect(function()
		updateSlot(slotData)
	end)

	slotData.Amount.Changed:Connect(function()
		updateSlot(slotData)
	end)

	updateSlot(slotData)
end

for _, slotData in ipairs(inventory:GetChildren()) do
	bindSlot(slotData)
end

local function isValidSlotNumber(slotNumber)
	return typeof(slotNumber) == "number" and slotNumber >= 1 and slotNumber <= 6
end

local function selectSlot(slotNumber)
	if not isValidSlotNumber(slotNumber) then
		warn("Invalid slot number:", slotNumber)
		return
	end
	
	selectedSlotNumber = slotNumber

	for i = 1, 6 do
		local slot = hotbarFrame:FindFirstChild("Slot" .. i)
		if slot then
			local stroke = slot:FindFirstChildWhichIsA("UIStroke")
			if i == selectedSlotNumber then
				slot.BackgroundColor3 = selectedColor

				if stroke then
					stroke.Color = selectedStrokeColor
					stroke.Thickness = 4
				end
			else
				slot.BackgroundColor3 = normalColor

				if stroke then
					stroke.Color = normalStrokeColor
					stroke.Thickness = 3
				end
			end
		end
	end
	setSelectedSlotEvent:FireServer(slotNumber)
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end

	local keyToSlot = {
		[Enum.KeyCode.One] = 1,
		[Enum.KeyCode.Two] = 2,
		[Enum.KeyCode.Three] = 3,
		[Enum.KeyCode.Four] = 4,
		[Enum.KeyCode.Five] = 5,
		[Enum.KeyCode.Six] = 6,
	}

	local slotNumber = keyToSlot[input.KeyCode]
	if slotNumber then
		selectSlot(slotNumber)
	end
end)

for i = 1, 6 do
	local slot = hotbarFrame:FindFirstChild("Slot" .. i)
	if slot then
		local clickButton = slot:WaitForChild("TextButton")

		clickButton.MouseButton1Click:Connect(function()
			selectSlot(i)
		end)
	end
end

selectSlot(1)]]></ProtectedString>
