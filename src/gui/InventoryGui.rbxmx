				<string name="Name">InventoryOnChangeScript</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
			</Properties>
		</Item>
	<Item class="LocalScript" referent="RBX_StarterGui_InventoryGui_ResponsiveLayout"><Properties><string name="Name">ResponsiveLayout</string><ProtectedString name="Source"><![CDATA[local UserInputService = game:GetService("UserInputService")

local gui = script.Parent
local hotbar = gui:WaitForChild("HotbarFrame")

local function updatePosition()
    local screenSize = gui.AbsoluteSize

    if UserInputService.TouchEnabled and screenSize.Y > screenSize.X then
        hotbar.Position = UDim2.new(0.5, 0, 1, -112)
    else
        hotbar.Position = UDim2.fromScale(0.5, 0.98)
    end
end

gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(updatePosition)
UserInputService:GetPropertyChangedSignal("TouchEnabled"):Connect(updatePosition)
updatePosition()
]]></ProtectedString></Properties></Item>
</Item>
	<SharedStrings>
		<SharedString md5="yuZpQdnvvUBOTYh1jqZ2cA=="></SharedString>
	</SharedStrings>
