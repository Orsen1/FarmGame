			<Properties>
				<ProtectedString name="Source">local replicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)

local setSelectedSlotEvent = replicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("SetSelectedSlotEvent")
local ItemDefinitions = require(replicatedStorage:WaitForChild("Configs"):WaitForChild("ItemDefinitions"))
local CropConfig = require(replicatedStorage.Configs.CropConfig)
local placementScripts = replicatedStorage:FindFirstChild("PlacementScripts")
local PlacementController = placementScripts and require(placementScripts:WaitForChild("PlacementController"))

local player = game.Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local inventory = player:WaitForChild("Inventory")
local hotbarFrame = script.Parent:WaitForChild("HotbarFrame")
local UserInputService = game:GetService("UserInputService")
local selectedSlotNumber = 1
local normalColor = Color3.fromRGB(255, 235, 180)
local selectedColor = Color3.fromRGB(220, 180, 110)
local normalStrokeColor = Color3.fromRGB(190, 140, 70)
local selectedStrokeColor = Color3.fromRGB(120, 80, 35)

local GuiService = game:GetService("GuiService")
local moveInventorySlotEvent = replicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("MoveInventorySlotEvent")

local dragging = false
local closeDiscard


local function getSelectedItemName()
	local selectedSlot = inventory:FindFirstChild("Slot" .. selectedSlotNumber)

	if not selectedSlot then
		return ""
	end

	return selectedSlot.ItemName.Value
end

local function isSeed(itemName)
	return itemName:match("Seed$") ~= nil
end

local function getIcon(itemName)
	local item = ItemDefinitions[itemName]
	local icon = item and item.Icon

	if typeof(icon) == "string" and icon:find("://", 1, true) then
		return icon
	end

	return ""
end

local iconStates = {}
task.spawn(function()
    while script.Parent do
        task.wait(0.5)
        for icon, state in pairs(iconStates) do
            state.Fallback.Visible = state.Slot.ItemName.Value ~= "" and state.Slot.Amount.Value &gt; 0 and not icon.IsLoaded
        end
    end
end)

local function updateSlot(slotData)
	local guiSlot = hotbarFrame:FindFirstChild(slotData.Name)
	if not guiSlot then
		return
	end

	local itemIcon = guiSlot:WaitForChild("ItemIcon")
	local amountText = guiSlot:WaitForChild("AmountText")
    local fallback = guiSlot:FindFirstChild("ItemNameFallback")
    if not fallback then
        fallback = Instance.new("TextLabel")
        fallback.Name = "ItemNameFallback"
        fallback.BackgroundTransparency = 1
        fallback.Position = UDim2.fromOffset(5, 5)
        fallback.Size = UDim2.new(1, -10, 1, -23)
        fallback.Font = Enum.Font.FredokaOne
        fallback.TextColor3 = Color3.fromRGB(89, 55, 26)
        fallback.TextScaled = true
        fallback.TextWrapped = true
        fallback.ZIndex = itemIcon.ZIndex
        fallback.Parent = guiSlot
        local limit = Instance.new("UITextSizeConstraint")
        limit.MinTextSize = 10
        limit.MaxTextSize = 15
        limit.Parent = fallback
    end
    iconStates[itemIcon] = {Slot = slotData, Fallback = fallback}
    fallback.Visible = false
    local badge = guiSlot:FindFirstChild("CoopContents")
    if not badge then
        badge = Instance.new("TextLabel")
        badge.Name = "CoopContents"
        badge.Position = UDim2.fromOffset(3, 3)
        badge.Size = UDim2.new(1, -6, 0, 16)
        badge.BackgroundColor3 = Color3.fromRGB(255, 226, 169)
        badge.BackgroundTransparency = 0.1
        badge.BorderSizePixel = 0
        badge.Font = Enum.Font.FredokaOne
        badge.TextSize = 10
        badge.TextColor3 = Color3.fromRGB(89, 55, 26)
        badge.ZIndex = itemIcon.ZIndex + 1
        badge.Parent = guiSlot
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 5)
        corner.Parent = badge
    end
    badge.Visible = false
    local encoded = slotData:GetAttribute("ObjectData")
    if encoded then
        local ok, data = pcall(game:GetService("HttpService").JSONDecode, game:GetService("HttpService"), encoded)
        if ok and data.Contents and data.Contents.Animals then
            badge.Text = #data.Contents.Animals .. " birds"
            badge.Visible = true
        end
    end

	local itemName = slotData.ItemName.Value
	local amount = slotData.Amount.Value

	if itemName == "" or amount &lt;= 0 then
		itemIcon.Image = ""
		amountText.Text = ""
		return
	end

	itemIcon.Image = getIcon(itemName)
    local definition = ItemDefinitions[itemName]
    fallback.Text = definition and definition.DisplayName or itemName
    fallback.Visible = not itemIcon.IsLoaded
	amountText.Text = tostring(amount)
end

local function bindSlot(slotData)
    slotData:GetAttributeChangedSignal("ObjectData"):Connect(function() updateSlot(slotData) end)
	slotData.ItemName.Changed:Connect(function()
		updateSlot(slotData)
	end)

	slotData.Amount.Changed:Connect(function()
		updateSlot(slotData)
	end)

	updateSlot(slotData)
end

for _, slotData in ipairs(inventory:GetChildren()) do
	bindSlot(slotData)
end

local function isValidSlotNumber(slotNumber)
	return typeof(slotNumber) == "number" and slotNumber &gt;= 1 and slotNumber &lt;= 6
end

local function selectSlot(slotNumber, activatePlacement)
	if dragging or player:GetAttribute("StorageOpen") == true or player:GetAttribute("FeederOpen") == true then
        return
    end

	if not isValidSlotNumber(slotNumber) then
		warn("Invalid slot number:", slotNumber)
		return
	end
	
	if closeDiscard then closeDiscard() end
	selectedSlotNumber = slotNumber

	for i = 1, 6 do
		local slot = hotbarFrame:FindFirstChild("Slot" .. i)
		if slot then
			local stroke = slot:FindFirstChildWhichIsA("UIStroke")
			if i == selectedSlotNumber then
				slot.BackgroundColor3 = selectedColor

				if stroke then
					stroke.Color = selectedStrokeColor
					stroke.Thickness = 4
				end
			else
				slot.BackgroundColor3 = normalColor

				if stroke then
					stroke.Color = normalStrokeColor
					stroke.Thickness = 3
				end
			end
		end
	end
	setSelectedSlotEvent:FireServer(slotNumber)

	if not PlacementController then
		return
	end

	PlacementController.cancelPlacement()

	if activatePlacement ~= false then
    	local selectedSlot = inventory:FindFirstChild("Slot" .. slotNumber)

    	if selectedSlot and selectedSlot.Amount.Value &gt; 0 then
			local itemName = selectedSlot.ItemName.Value
			local itemDefinition = ItemDefinitions[itemName]
			if itemDefinition and itemDefinition.Placeable == true then
				PlacementController.startPlacement(itemName, slotNumber)
			end
    	end
	end
end

local selectFunction = Instance.new("BindableFunction")
selectFunction.Name, selectFunction.Parent = "SelectSlot", script.Parent
selectFunction.OnInvoke = function(index) selectSlot(index, true) end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end

	local keyToSlot = {
		[Enum.KeyCode.One] = 1,
		[Enum.KeyCode.Two] = 2,
		[Enum.KeyCode.Three] = 3,
		[Enum.KeyCode.Four] = 4,
		[Enum.KeyCode.Five] = 5,
		[Enum.KeyCode.Six] = 6,
	}

	local slotNumber = keyToSlot[input.KeyCode]
	if slotNumber then
		selectSlot(slotNumber)
	end
end)

local press = nil
local pendingMove = false
local lastTap
local DRAG_DISTANCE = 8
local HOLD_TO_DRAG = 0.25
local DOUBLE_TAP_WINDOW = 0.4

-- Отдельный слой позволяет видеть перетаскиваемую иконку над окном склада.
local dragGui = Instance.new("ScreenGui")
dragGui.Name = "InventoryDragGui"
dragGui.DisplayOrder = 50
dragGui.ResetOnSpawn = false
dragGui.ScreenInsets = script.Parent.ScreenInsets
dragGui.Parent = player.PlayerGui

local dragIcon = Instance.new("ImageLabel")
dragIcon.Size = UDim2.fromOffset(64, 64)
dragIcon.AnchorPoint = Vector2.new(0.5, 0.5)
dragIcon.BackgroundColor3 = normalColor
dragIcon.BackgroundTransparency = 0.15
dragIcon.Visible = false
dragIcon.Parent = dragGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = dragIcon

local dragAmount = Instance.new("TextLabel")
dragAmount.Size = UDim2.fromScale(1, 0.3)
dragAmount.Position = UDim2.fromScale(0, 0.7)
dragAmount.BackgroundTransparency = 1
dragAmount.TextColor3 = Color3.fromRGB(60, 40, 20)
dragAmount.TextScaled = true
dragAmount.Font = Enum.Font.GothamBold
dragAmount.Parent = dragIcon

local function getStorage()
    local gui = player.PlayerGui:FindFirstChild("StorageGui")
    local panel = gui and gui:FindFirstChild("Panel")
    local session = gui and gui:GetAttribute("StorageSession")
    if gui and gui.Enabled and panel and panel.Visible and session then
        return player:FindFirstChild("StorageInventory"), panel.Grid, session
    end
end

local function readSlot(index, area)
    local folder = inventory
    if area == "Storage" then
        folder = getStorage()
    end
    if not folder then
        return nil
    end
    local slot = folder:FindFirstChild("Slot" .. index)
    local name = slot and slot:FindFirstChild("ItemName")
    local amount = slot and slot:FindFirstChild("Amount")
    if name and amount then
        return {ItemName = name.Value, Amount = amount.Value, ObjectData = slot:GetAttribute("ObjectData"),
            PaidLots = slot:GetAttribute("PaidLots")}
    end
end

local function findSlotAt(point)
    local _, storageGrid = getStorage()
    for _, hit in ipairs(player.PlayerGui:GetGuiObjectsAtPosition(point.X, point.Y)) do
        local object = hit
        while object do
            local area
            if object.Parent == hotbarFrame then
                area = "Player"
            elseif storageGrid and object.Parent == storageGrid then
                area = "Storage"
            end
            if area then
                local index = tonumber(object.Name:match("^Slot(%d+)$"))
                if index then
                    return index, area
                end
            end
            object = object.Parent
        end
    end
end

local function cancelDrag()
    if press and press.Grid then
        press.Grid.ScrollingEnabled = true
    end
    press = nil
    dragging = false
    dragIcon.Visible = false
end

local function startDrag()
    if not press or dragging or press.Data.ItemName == "" or press.Data.Amount &lt;= 0 then
        return
    end
    if player:GetAttribute("ProductionMode") == true
        or not hotbarFrame.Visible or not script.Parent.Enabled then
        cancelDrag()
        return
    end
    press.Moved = true
    lastTap = nil
    dragging = true
    if press.Grid then
        press.Grid.ScrollingEnabled = false
    end
    if PlacementController then
        PlacementController.cancelPlacement()
    end
    dragIcon.Image = getIcon(press.Data.ItemName)
    dragAmount.Text = tostring(press.Data.Amount)
    dragIcon.Position = UDim2.fromOffset(press.Point.X, press.Point.Y)
    dragIcon.Visible = true
end

local function bindButton(button, index, area)
    button.InputBegan:Connect(function(input)
        local isMouse = input.UserInputType == Enum.UserInputType.MouseButton1
        local isTouch = input.UserInputType == Enum.UserInputType.Touch
        if not isMouse and not isTouch then
            return
        end
        if press or pendingMove or player:GetAttribute("DataLoaded") ~= true
            or player:GetAttribute("ProductionMode") == true then
            return
        end

        local data = readSlot(index, area)
        if not data then
            return
        end
        local _, storageGrid, storageSession = getStorage()
        local point = Vector2.new(input.Position.X, input.Position.Y)
        local state = {
            Input = input, Index = index, Area = area, Data = data,
            Start = point, Point = point, Moved = false, StartedAt = os.clock(),
            StorageSession = storageSession,
            QuickTransfer = storageSession and isMouse and (UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
                or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)),
            Grid = area == "Storage" and storageGrid or nil,
            TouchStorage = isTouch and area == "Storage",
        }
        press = state

        -- Короткое движение пальцем прокручивает склад; удержание берёт предмет.
        if state.TouchStorage then
            task.delay(HOLD_TO_DRAG, function()
                if press == state then
                    startDrag()
                end
            end)
        end
    end)
end

for index = 1, 6 do
    bindButton(hotbarFrame:WaitForChild("Slot" .. index):WaitForChild("TextButton"), index, "Player")
end

local boundStorageGuis = setmetatable({}, {__mode = "k"})
local function bindStorageGui(gui)
    if gui.Name ~= "StorageGui" or not gui:IsA("ScreenGui") or boundStorageGuis[gui] then
        return
    end
    boundStorageGuis[gui] = true
    local grid = gui:WaitForChild("Panel"):WaitForChild("Grid")
    local function resetTap() lastTap = nil end
    grid:GetPropertyChangedSignal("CanvasPosition"):Connect(resetTap)
    gui:GetAttributeChangedSignal("StorageSession"):Connect(resetTap)
    for index = 1, 24 do
        bindButton(grid:WaitForChild("Slot" .. index):WaitForChild("TextButton"), index, "Storage")
    end
end
player.PlayerGui.ChildAdded:Connect(bindStorageGui)
local storageGui = player.PlayerGui:FindFirstChild("StorageGui")
if storageGui then
    task.spawn(bindStorageGui, storageGui)
end

UserInputService.InputChanged:Connect(function(input)
    if not press then
        return
    end
    local mouseMove = press.Input.UserInputType == Enum.UserInputType.MouseButton1
        and input.UserInputType == Enum.UserInputType.MouseMovement
    if not mouseMove and input ~= press.Input then
        return
    end
    if player:GetAttribute("ProductionMode") == true
        or not hotbarFrame.Visible or not script.Parent.Enabled then
        cancelDrag()
        return
    end

    local point = Vector2.new(input.Position.X, input.Position.Y)
    press.Point = point
    if not dragging and (point - press.Start).Magnitude &gt;= DRAG_DISTANCE then
        press.Moved = true
        lastTap = nil
        if press.TouchStorage then
            cancelDrag()
            return
        end
        startDrag()
    end
    if dragging then
        dragIcon.Position = UDim2.fromOffset(point.X, point.Y)
    end
end)

local function requestMove(source, targetIndex, targetData, targetArea, storageSession)
    pendingMove = true
    moveInventorySlotEvent:FireServer(source.Index, targetIndex, source.Data, targetData,
        source.Area, targetArea, storageSession)
end

local function quickTransfer(source)
    local _, _, storageSession = getStorage()
    if not storageSession or storageSession ~= source.StorageSession or source.Data.Amount &lt;= 0 then return end
    local destination = source.Area == "Player" and "Storage" or "Player"
    requestMove(source, "FirstFree", nil, destination, storageSession)
end

local function isDoubleTap(source)
    local previous = lastTap
    lastTap = nil
    local now = os.clock()
    local data = source.Data
    if not source.StorageSession or data.Amount &lt;= 0 or now - source.StartedAt &gt;= HOLD_TO_DRAG then return false end
    if previous and now - previous.TappedAt &lt;= DOUBLE_TAP_WINDOW and previous.StorageSession == source.StorageSession and
        previous.Area == source.Area and previous.Index == source.Index and previous.Data.ItemName == data.ItemName and
        previous.Data.Amount == data.Amount and previous.Data.ObjectData == data.ObjectData and previous.Data.PaidLots == data.PaidLots then
        return true
    end
    source.TappedAt = now
    lastTap = source
    return false
end

UserInputService.InputEnded:Connect(function(input)
    if not press then
        return
    end
    local mouse = press.Input.UserInputType == Enum.UserInputType.MouseButton1
    if mouse then
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
            return
        end
    elseif input ~= press.Input then
        return
    end

    local finished, wasDragging = press, dragging
    local point = Vector2.new(input.Position.X, input.Position.Y)
    if mouse then
        local inset = GuiService:GetGuiInset()
        point = UserInputService:GetMouseLocation() - inset
    end
    cancelDrag()

    if player:GetAttribute("ProductionMode") == true
        or not hotbarFrame.Visible or not script.Parent.Enabled then
        lastTap = nil
        return
    end
    local targetIndex, targetArea = findSlotAt(point)
    if not targetIndex then
        lastTap = nil
        return
    end
    local sameSlot = targetIndex == finished.Index and targetArea == finished.Area
    if wasDragging then
        if sameSlot then
            return
        end
        local _, _, storageSession = getStorage()
        if (finished.Area == "Storage" or targetArea == "Storage")
            and (not storageSession or storageSession ~= finished.StorageSession) then
            return
        end
        local targetData = readSlot(targetIndex, targetArea)
        if targetData then
            requestMove(finished, targetIndex, targetData, targetArea, storageSession)
        end
    elseif not finished.Moved and sameSlot then
        if mouse then lastTap = nil end
        if finished.QuickTransfer or (not mouse and isDoubleTap(finished)) then
            quickTransfer(finished)
        elseif finished.Area == "Player" then
            selectSlot(finished.Index)
        end
    else
        lastTap = nil
    end
end)

local function cancelGesture()
    lastTap = nil
    cancelDrag()
end

player:GetAttributeChangedSignal("StorageOpen"):Connect(function()
    if player:GetAttribute("StorageOpen") ~= true then
        cancelGesture()
    end
end)
UserInputService.WindowFocusReleased:Connect(cancelGesture)
player.CharacterRemoving:Connect(cancelGesture)

moveInventorySlotEvent.OnClientEvent:Connect(function(success, reason)
    pendingMove = false
    if not success then
        warn("[INVENTORY] Move cancelled:", reason)
    end
end)

script.Destroying:Connect(function()
    cancelDrag()
    dragGui:Destroy()
end)

selectSlot(1, false)

local discardEvent = replicatedStorage.RemoteEvents:WaitForChild("DiscardInventoryItemEvent")
local discardSnapshot, discardIndex, discardPending
local discardGui = Instance.new("ScreenGui")
discardGui.Name, discardGui.ResetOnSpawn, discardGui.DisplayOrder = "InventoryDiscardGui", false, 60
discardGui.ScreenInsets, discardGui.Enabled = script.Parent.ScreenInsets, false
discardGui.Parent = player.PlayerGui
local function discardMake(class, parent, properties)
    local object = Instance.new(class)
    for name, value in pairs(properties) do object[name] = value end
    object.Parent = parent
    return object
end
local function discardRound(object)
    discardMake("UICorner", object, {CornerRadius = UDim.new(0, 12)})
    discardMake("UIStroke", object, {Color = normalStrokeColor, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border})
end
local function discardButton(parent, name, caption, color)
    local object = discardMake("TextButton", parent, {Name = name, Text = caption, TextSize = 17,
        Font = Enum.Font.FredokaOne, TextColor3 = Color3.fromRGB(255, 243, 216),
        BackgroundColor3 = color or Color3.fromRGB(166, 75, 45), BorderSizePixel = 0})
    discardRound(object)
    return object
end
local function discardText(parent, name, caption, position, size, textSize)
    return discardMake("TextLabel", parent, {Name = name, Text = caption, Position = position, Size = size,
        BackgroundTransparency = 1, Font = Enum.Font.FredokaOne, TextSize = textSize or 18,
        TextWrapped = true, TextColor3 = Color3.fromRGB(89, 55, 26)})
end
local trash = discardButton(script.Parent, "DiscardButton", "Discard")
trash.Size = UDim2.fromOffset(84, 44)
local seedPrice = discardText(script.Parent, "NextSeedPrice", "", UDim2.new(), UDim2.fromOffset(142, 36), 15)
seedPrice.BackgroundTransparency = 0
seedPrice.BackgroundColor3 = normalColor
seedPrice.BorderSizePixel = 0
discardRound(seedPrice)
local blocker = discardMake("TextButton", discardGui, {Name = "BlockInput", Text = "", Size = UDim2.fromScale(1, 1),
    BackgroundTransparency = 1, AutoButtonColor = false})
local discardPanel = discardMake("Frame", discardGui, {Name = "Panel", AnchorPoint = Vector2.new(.5, .5),
    Position = UDim2.fromScale(.5, .5), Size = UDim2.fromOffset(360, 250),
    BackgroundColor3 = Color3.fromRGB(255, 220, 150), BorderSizePixel = 0, Active = true})
discardMake("UISizeConstraint", discardPanel, {MaxSize = Vector2.new(360, 250)})
discardPanel.Size = UDim2.new(1, -24, 0, 250)
discardRound(discardPanel)
discardText(discardPanel, "Title", "Discard entire slot?", UDim2.fromOffset(16, 12), UDim2.new(1, -32, 0, 28), 24)
local discardIcon = discardMake("ImageLabel", discardPanel, {Name = "ItemIcon", BackgroundTransparency = 1,
    Position = UDim2.fromOffset(18, 50), Size = UDim2.fromOffset(52, 52), ScaleType = Enum.ScaleType.Fit})
local discardName = discardText(discardPanel, "ItemName", "", UDim2.fromOffset(80, 50), UDim2.new(1, -96, 0, 52), 21)
local discardNotice = discardText(discardPanel, "Notice", "", UDim2.fromOffset(16, 108), UDim2.new(1, -32, 0, 42), 15)
local discardStatus = discardText(discardPanel, "Status", "", UDim2.fromOffset(16, 157), UDim2.new(1, -32, 0, 26), 14)
local cancel = discardButton(discardPanel, "Cancel", "Cancel", Color3.fromRGB(139, 113, 75))
cancel.Position, cancel.Size = UDim2.fromOffset(16, 196), UDim2.new(.5, -22, 0, 44)
local confirm = discardButton(discardPanel, "Confirm", "Discard")
confirm.Position, confirm.Size = UDim2.new(.5, 6, 0, 196), UDim2.new(.5, -22, 0, 44)
local blockedAttributes = {"ProductionMode", "Milking", "Teleporting", "StorageOpen", "FeederOpen", "AnimalMenuOpen"}
local function discardAvailable()
    if player:GetAttribute("DataLoaded") ~= true or not script.Parent.Enabled or not hotbarFrame.Visible then return false end
    if UserInputService.PreferredInput == Enum.PreferredInput.Touch and playerGui:FindFirstChild("PlacementControls") then return false end
    for _, name in ipairs(blockedAttributes) do if player:GetAttribute(name) == true then return false end end
    return true
end
closeDiscard = function()
    discardGui.Enabled = false
    discardSnapshot = nil
    game.ContextActionService:UnbindAction("InventoryDiscardKeys")
end
local function updateDiscard()
    local selected = readSlot(selectedSlotNumber, "Player")
    local definition = selected and ItemDefinitions[selected.ItemName]
    local seed = definition and definition.Type == "Seed"
    local available = discardAvailable() and selected ~= nil and selected.Amount &gt; 0
    trash.Visible = available and not seed
    trash.Interactable = not discardPending
    seedPrice.Visible = available and seed == true
    if seedPrice.Visible then
        local bought = player:GetAttribute(CropConfig.SeedPurchaseAttribute(definition.PlantId)) or 0
        local price = CropConfig.SeedPrice(definition.BuyPriceCents, bought)
        seedPrice.Text = string.format("Next seed: $%.2f", price / 100)
    end
    local origin = hotbarFrame.AbsolutePosition - script.Parent.AbsolutePosition
    trash.Position = UDim2.fromOffset(origin.X + 4, math.max(8, origin.Y - 50))
    seedPrice.Position = UDim2.fromOffset(origin.X + 4, math.max(8, origin.Y - 42))
    if discardSnapshot and (not discardAvailable() or discardIndex ~= selectedSlotNumber or not selected or
        selected.ItemName ~= discardSnapshot.ItemName or selected.Amount ~= discardSnapshot.Amount or
        selected.ObjectData ~= discardSnapshot.ObjectData or selected.PaidLots ~= discardSnapshot.PaidLots) then closeDiscard() end
end
trash.Activated:Connect(function()
    if not discardAvailable() or discardPending or dragging or pendingMove then return end
    local data = readSlot(selectedSlotNumber, "Player")
    if not data or data.Amount &lt; 1 or ItemDefinitions[data.ItemName].Type == "Seed" then return end
    cancelDrag()
    if PlacementController then PlacementController.cancelPlacement() end
    discardSnapshot, discardIndex = data, selectedSlotNumber
    local definition = ItemDefinitions[data.ItemName]
    discardName.Text, discardIcon.Image = definition.DisplayName .. " x" .. data.Amount, getIcon(data.ItemName)
    discardNotice.Text = data.ObjectData and "Packed contents will also be lost." or "Items are permanently removed. No money is returned."
    discardStatus.Text = "All items in this slot will be lost"
    confirm.Interactable = true
    discardGui.Enabled = true
    game.ContextActionService:BindActionAtPriority("InventoryDiscardKeys", function(_, state, input)
        if state == Enum.UserInputState.Begin and input.KeyCode == Enum.KeyCode.Q then closeDiscard() end
        return Enum.ContextActionResult.Sink
    end, false, 3500, Enum.KeyCode.Q, Enum.KeyCode.E, Enum.KeyCode.One, Enum.KeyCode.Two,
        Enum.KeyCode.Three, Enum.KeyCode.Four, Enum.KeyCode.Five, Enum.KeyCode.Six)
end)
cancel.Activated:Connect(closeDiscard)
blocker.Activated:Connect(closeDiscard)
confirm.Activated:Connect(function()
    if not discardSnapshot or discardPending or not discardAvailable() then return end
    discardPending = true
    confirm.Interactable = false
    discardEvent:FireServer(discardIndex, discardSnapshot)
end)
discardEvent.OnClientEvent:Connect(function(success)
    discardPending = false
    if success then closeDiscard()
    else discardStatus.Text = "Inventory changed. Close and try again.";confirm.Interactable = false end
    updateDiscard()
end)
for _, name in ipairs(blockedAttributes) do player:GetAttributeChangedSignal(name):Connect(updateDiscard) end
player:GetAttributeChangedSignal("DataLoaded"):Connect(updateDiscard)
player:GetAttributeChangedSignal("SelectedSlot"):Connect(updateDiscard)
hotbarFrame:GetPropertyChangedSignal("AbsolutePosition"):Connect(updateDiscard)
hotbarFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateDiscard)
hotbarFrame:GetPropertyChangedSignal("Visible"):Connect(updateDiscard)
script.Parent:GetPropertyChangedSignal("Enabled"):Connect(updateDiscard)
local function placementChanged(gui)
    if gui.Name == "PlacementControls" then updateDiscard() end
end
playerGui.ChildAdded:Connect(placementChanged)
playerGui.ChildRemoved:Connect(placementChanged)
UserInputService:GetPropertyChangedSignal("PreferredInput"):Connect(updateDiscard)
for _, slot in ipairs(inventory:GetChildren()) do
    slot.ItemName.Changed:Connect(updateDiscard)
    slot.Amount.Changed:Connect(updateDiscard)
    slot:GetAttributeChangedSignal("ObjectData"):Connect(updateDiscard)
    slot:GetAttributeChangedSignal("PaidLots"):Connect(updateDiscard)
end
for crop in pairs(CropConfig.Crops) do
    player:GetAttributeChangedSignal(CropConfig.SeedPurchaseAttribute(crop)):Connect(updateDiscard)
end
player.CharacterRemoving:Connect(closeDiscard)
script.Destroying:Connect(function() closeDiscard();discardGui:Destroy();trash:Destroy();seedPrice:Destroy() end)
updateDiscard()
</ProtectedString>
