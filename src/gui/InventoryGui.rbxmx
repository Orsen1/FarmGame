		<Item class="LocalScript" referent="RBXC92EC04B75844851971BAC59A3B9AEAD">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local UserInputService = game:GetService("UserInputService")

local gui = script.Parent
local hotbar = gui:WaitForChild("HotbarFrame")

local function updatePosition()
    local screenSize = gui.AbsoluteSize

    if UserInputService.TouchEnabled and screenSize.Y > screenSize.X then
        hotbar.Position = UDim2.new(0.5, 0, 1, -112)
    else
        hotbar.Position = UDim2.fromScale(0.5, 0.98)
    end
end

gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(updatePosition)
UserInputService:GetPropertyChangedSignal("TouchEnabled"):Connect(updatePosition)
updatePosition()
]]></ProtectedString>
