				<Item class="LocalScript" referent="RBXDA65C45B58CC473D860DD1DA0BC9A78D">
					<Properties>
						<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local inventory = player:WaitForChild("Inventory")
local remoteEvents = ReplicatedStorage:WaitForChild("RemoteEvents")
local sellItemEvent = remoteEvents:WaitForChild("SellItemEvent")
local ItemDefinitions = require(ReplicatedStorage:WaitForChild("Configs"):WaitForChild("ItemDefinitions"))

local itemSellFrame = script.Parent
local innerFrame = itemSellFrame.Parent:WaitForChild("InnerFrame")
local itemNameLabel = itemSellFrame.ItemHeaderFrame.ItemNameLabel
local amountLabel = itemSellFrame.OwnedAndPriceFrame.AmountLabel
local priceLabel = itemSellFrame.OwnedAndPriceFrame.PriceLabel
local plusButton = itemSellFrame.PlusButton
local minusButton = itemSellFrame.MinusButton
local maxButton = itemSellFrame.MaxButton
local selectedAmountLabel = itemSellFrame.SelectedAmountFrame.ItemAmountToSellLabel
local sellButton = itemSellFrame.ItemSellButtonFrame.SellButton
local totalPriceLabel = itemSellFrame.ItemSellButtonFrame.TotalPriceLabel
local backButton = itemSellFrame.BackButton

local selectedAmount = 0
local GREEN = sellButton.BackgroundColor3
local RED = plusButton.BackgroundColor3
local DISABLED = Color3.fromRGB(194, 165, 108)

local function getItemAmount(itemName)
    local totalAmount = 0
    for _, slot in ipairs(inventory:GetChildren()) do
        local name = slot:FindFirstChild("ItemName")
        local amount = slot:FindFirstChild("Amount")
        if name and amount and name.Value == itemName then
            totalAmount += amount.Value
        end
    end
    return totalAmount
end

local function itemDisplayName(itemName, item)
    local name = item.DisplayName
    if typeof(name) == "string" and name ~= "" and not name:find("[\128-\255]") then
        return name
    end
    return (itemName:gsub("(%l)(%u)", "%1 %2"):gsub("_", " "))
end

local function enableButton(button, enabled, color)
    button.Interactable = enabled
    button.Selectable = enabled
    button.AutoButtonColor = enabled
    button.BackgroundColor3 = enabled and color or DISABLED
end

local function updateItemSellFrame()
    local itemName = itemSellFrame:GetAttribute("ItemName")
    local item = itemName and ItemDefinitions[itemName]
    local price = item and item.SellPriceCents
    if typeof(price) ~= "number" then return end

    local ownedAmount = getItemAmount(itemName)
    selectedAmount = math.clamp(selectedAmount, 0, ownedAmount)
    itemNameLabel.Text = itemDisplayName(itemName, item)
    amountLabel.Text = tostring(ownedAmount)
    priceLabel.Text = string.format("$%.2f", price / 100)
    selectedAmountLabel.Text = tostring(selectedAmount)
    totalPriceLabel.Text = string.format("$%.2f", selectedAmount * price / 100)

    enableButton(minusButton, selectedAmount > 0, RED)
    enableButton(plusButton, selectedAmount < ownedAmount, RED)
    enableButton(maxButton, ownedAmount > 0, GREEN)
    enableButton(sellButton, selectedAmount > 0, GREEN)
end

itemSellFrame:GetPropertyChangedSignal("Visible"):Connect(function()
    if itemSellFrame.Visible then
        selectedAmount = 0
        updateItemSellFrame()
    end
end)

itemSellFrame:GetAttributeChangedSignal("ItemName"):Connect(function()
    selectedAmount = 0
    updateItemSellFrame()
end)

plusButton.Activated:Connect(function()
    selectedAmount += 1
    updateItemSellFrame()
end)

minusButton.Activated:Connect(function()
    selectedAmount -= 1
    updateItemSellFrame()
end)

maxButton.Activated:Connect(function()
    local itemName = itemSellFrame:GetAttribute("ItemName")
    if not itemName then return end
    selectedAmount = getItemAmount(itemName)
    updateItemSellFrame()
end)

sellButton.Activated:Connect(function()
    updateItemSellFrame()
    local itemName = itemSellFrame:GetAttribute("ItemName")
    if not itemName or selectedAmount <= 0 or not sellButton.Interactable then return end
    sellItemEvent:FireServer(itemName, selectedAmount)
end)

backButton.Activated:Connect(function()
    itemSellFrame.Visible = false
    innerFrame.Visible = true
    selectedAmount = 0
end)

local watched = {}
local function watch(value)
    if value:IsA("ValueBase") and not watched[value] then
        watched[value] = value.Changed:Connect(updateItemSellFrame)
    end
end
for _, value in ipairs(inventory:GetDescendants()) do watch(value) end
inventory.DescendantAdded:Connect(function(value)
    watch(value)
    updateItemSellFrame()
end)
inventory.DescendantRemoving:Connect(function(value)
    if watched[value] then
        watched[value]:Disconnect()
        watched[value] = nil
    end
    task.defer(updateItemSellFrame)
end)
updateItemSellFrame()
]]></ProtectedString>
