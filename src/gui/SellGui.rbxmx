		<Item class="LocalScript" referent="RBX672F25DC38E24D55911D051A41E26B6B">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local sellGui = script.Parent
local mainFrame = sellGui:WaitForChild("MainFrame")
local innerFrame = mainFrame:WaitForChild("InnerFrame")
local itemsFrame = innerFrame:WaitForChild("ItemsFrame")
local itemSellFrame = mainFrame:WaitForChild("ItemSellFrame")
local template = sellGui:WaitForChild("Templates"):WaitForChild("ItemCardTemplate")
local closeButton = mainFrame.HeaderFrame.CloseButton

local remoteEvents = ReplicatedStorage:WaitForChild("RemoteEvents")
local openSellGuiEvent = remoteEvents:WaitForChild("OpenSellGuiEvent")
local ItemDefinitions = require(ReplicatedStorage:WaitForChild("Configs"):WaitForChild("ItemDefinitions"))
local MAX_INTEGER = 9007199254740991

mainFrame.Visible = false

local function itemDisplayName(itemName, item)
    local name = item.DisplayName
    if typeof(name) == "string" and name ~= "" and not name:find("[\128-\255]") then
        return name
    end
    return (itemName:gsub("(%l)(%u)", "%1 %2"):gsub("_", " "))
end

local function openItemSellFrame(itemName)
    itemSellFrame:SetAttribute("ItemName", itemName)
    innerFrame.Visible = false
    itemSellFrame.Visible = true
end

local itemNames = {}
for itemName, item in pairs(ItemDefinitions) do
    if typeof(itemName) == "string" and typeof(item) == "table" then
        local price = item.SellPriceCents
        if typeof(price) == "number" and price >= 0
            and price <= MAX_INTEGER and price % 1 == 0 then
            table.insert(itemNames, itemName)
        end
    end
end

table.sort(itemNames, function(a, b)
    local orderA = ItemDefinitions[a].SortOrder or math.huge
    local orderB = ItemDefinitions[b].SortOrder or math.huge
    if orderA ~= orderB then return orderA < orderB end
    return a < b
end)

for order, itemName in ipairs(itemNames) do
    local item = ItemDefinitions[itemName]
    local card = template:Clone()
    card.Name = itemName .. "Card"
    card.LayoutOrder = order
    card:SetAttribute("ItemName", itemName)
    card.SelectButton:SetAttribute("ItemName", itemName)
    card.SelectButton.Text = itemDisplayName(itemName, item)
    card.PriceLabel.Text = string.format("$%.2f / each", item.SellPriceCents / 100)
    card.OwnedLabel.Text = "You have: 0"
    card.SelectButton.Activated:Connect(function()
        openItemSellFrame(itemName)
    end)
    card.Visible = true
    card.Parent = itemsFrame
end

innerFrame.EmptyLabel.Visible = #itemNames == 0

openSellGuiEvent.OnClientEvent:Connect(function()
    innerFrame.Visible = true
    itemSellFrame.Visible = false
    itemsFrame.CanvasPosition = Vector2.new(0, 0)
    mainFrame.Visible = true
end)

closeButton.Activated:Connect(function()
    mainFrame.Visible = false
end)
]]></ProtectedString>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<token name="RunContext">0</token>
