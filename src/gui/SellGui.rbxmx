				<Item class="LocalScript" referent="RBXB477DE95B94840DFA99F28CFEB48E7D1">
					<Properties>
						<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local inventory = player:WaitForChild("Inventory")

local remoteEvents = ReplicatedStorage:WaitForChild("RemoteEvents")
local sellItemEvent = remoteEvents:WaitForChild("SellItemEvent")

local SellPrices = require(
	ReplicatedStorage:WaitForChild("Configs"):WaitForChild("SellPrices")
)

local itemSellFrame = script.Parent
local mainFrame = itemSellFrame.Parent
local innerFrame = mainFrame:WaitForChild("InnerFrame")

local itemHeaderFrame = itemSellFrame:WaitForChild("ItemHeaderFrame")
local itemNameLabel = itemHeaderFrame:WaitForChild("ItemNameLabel")

local ownedAndPriceFrame = itemSellFrame:WaitForChild("OwnedAndPriceFrame")
local amountLabel = ownedAndPriceFrame:WaitForChild("AmountLabel")
local priceLabel = ownedAndPriceFrame:WaitForChild("PriceLabel")

local plusButton = itemSellFrame:WaitForChild("PlusButton")
local minusButton = itemSellFrame:WaitForChild("MinusButton")

local selectedAmountFrame = itemSellFrame:WaitForChild("SelectedAmountFrame")
local selectedAmountLabel = selectedAmountFrame:WaitForChild("ItemAmountToSellLabel")

local itemSellButtonFrame = itemSellFrame:WaitForChild("ItemSellButtonFrame")
local sellButton = itemSellButtonFrame:WaitForChild("SellButton")
local totalPriceLabel = itemSellButtonFrame:WaitForChild("TotalPriceLabel")

local backButton = itemSellFrame:WaitForChild("BackButton")

local selectedAmount = 0


local function getItemAmount(itemName)
	local totalAmount = 0

	for _, slot in ipairs(inventory:GetChildren()) do
		local slotItemName = slot:FindFirstChild("ItemName")
		local slotAmount = slot:FindFirstChild("Amount")

		if slotItemName and slotAmount then
			if slotItemName.Value == itemName then
				totalAmount += slotAmount.Value
			end
		end
	end

	return totalAmount
end


local function updateItemSellFrame()
	local itemName = itemSellFrame:GetAttribute("ItemName")

	if not itemName then
		return
	end

	local price = SellPrices[itemName]

	if not price then
		warn("No sell price for item:", itemName)
		return
	end

	local ownedAmount = getItemAmount(itemName)

	selectedAmount = math.clamp(selectedAmount, 0, ownedAmount)

	itemNameLabel.Text = itemName
	amountLabel.Text = tostring(ownedAmount)
	priceLabel.Text = tostring(price)

	selectedAmountLabel.Text = tostring(selectedAmount)

	local totalPrice = selectedAmount * price
	totalPriceLabel.Text = tostring(totalPrice)
end


itemSellFrame:GetAttributeChangedSignal("ItemName"):Connect(function()
	selectedAmount = 0
	updateItemSellFrame()
end)


plusButton.MouseButton1Click:Connect(function()
	local itemName = itemSellFrame:GetAttribute("ItemName")

	if not itemName then
		return
	end

	local ownedAmount = getItemAmount(itemName)

	if selectedAmount < ownedAmount then
		selectedAmount += 1
	end

	updateItemSellFrame()
end)


minusButton.MouseButton1Click:Connect(function()
	if selectedAmount > 0 then
		selectedAmount -= 1
	end

	updateItemSellFrame()
end)


sellButton.MouseButton1Click:Connect(function()
	local itemName = itemSellFrame:GetAttribute("ItemName")

	if not itemName then
		return
	end

	if selectedAmount <= 0 then
		return
	end

	sellItemEvent:FireServer(itemName, selectedAmount)
end)


backButton.MouseButton1Click:Connect(function()
	itemSellFrame.Visible = false
	innerFrame.Visible = true

	selectedAmount = 0
end)


for _, slot in ipairs(inventory:GetChildren()) do
	local itemName = slot:WaitForChild("ItemName")
	local amount = slot:WaitForChild("Amount")

	itemName.Changed:Connect(updateItemSellFrame)
	amount.Changed:Connect(updateItemSellFrame)
end]]></ProtectedString>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<token name="RunContext">0</token>
						<string name="ScriptGuid">{18009D98-60E2-4ACD-B9C8-375EDB8C3F9B}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">ItemSellFrameScript</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
			</Item>
		</Item>
		<Item class="LocalScript" referent="RBXB9F9DABFABD045BF9A368F3C0D9F7B24">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local replicatedStorage = game:GetService("ReplicatedStorage")
local remoteEvents = replicatedStorage:WaitForChild("RemoteEvents")
local openSellGuiEvent = remoteEvents:WaitForChild("OpenSellGuiEvent")

local sellGui = script.Parent
local mainFrame = sellGui:WaitForChild("MainFrame")

local HeaderFrame = mainFrame:WaitForChild("HeaderFrame")
local closeButton = HeaderFrame:WaitForChild("CloseButton")

local innerFrame = mainFrame:WaitForChild("InnerFrame")
local itemSellFrame = mainFrame:WaitForChild("ItemSellFrame")

local carrotButton = mainFrame:WaitForChild("InnerFrame"):WaitForChild("CarrotFrame"):WaitForChild("CarrotButton")



mainFrame.Visible = false


openSellGuiEvent.OnClientEvent:Connect(function()
	mainFrame.Visible = true
	innerFrame.Visible = true
	itemSellFrame.Visible = false
end)

closeButton.MouseButton1Click:Connect(function()
	mainFrame.Visible = false
end)


local function openItemSellFrame(itemName)
	itemSellFrame:SetAttribute("ItemName", itemName)
	
	innerFrame.Visible = false
	itemSellFrame.Visible = true
	print("Selected item:", itemName)
end


for _, object in ipairs(innerFrame:GetDescendants()) do
	if object:IsA("TextButton") then
		local itemName = object:GetAttribute("ItemName")
		
		if itemName then
			object.MouseButton1Click:Connect(function()
