        <Item class="LocalScript" referent="RBX75F41A422B5B4780922BED32FF3BA4CE">
            <Properties>
                <string name="Name">MoneyController</string>
                <ProtectedString name="Source">local Players = game:GetService("Players")
local TextService = game:GetService("TextService")

local player = Players.LocalPlayer
local gui = script.Parent
local root = gui.Root
local window = root.Window
local amountLabel = window.AmountLabel
local money = player:WaitForChild("PlayerData"):WaitForChild("MoneyCents")

local function formatMoney(cents)
    local dollars = string.format("%.0f", math.floor(cents / 100))
    local grouped = dollars:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
    return "$" .. grouped .. string.format(".%02d", cents % 100)
end

local function refresh()
    local size = root.AbsoluteSize
    if size.X &lt; 1 then
        return
    end
    local phone = size.X &lt; 600 or size.Y &lt; 500
    local textSize = phone and 22 or 24
    local height = phone and 46 or 52
    local loaded = player:GetAttribute("DataLoaded") == true
    local text = loaded and formatMoney(money.Value) or "..."
    local textWidth = TextService:GetTextSize(text, textSize, Enum.Font.FredokaOne, Vector2.new(1000, height)).X
    local width = math.clamp(math.ceil(textWidth) + 70, phone and 164 or 184, math.min(360, size.X - 24))
    window.Size = UDim2.fromOffset(width, height)
    window.Icon.Size = UDim2.fromOffset(height - 12, height - 12)
    window.Icon.Position = UDim2.fromOffset(8, 6)
    amountLabel.Position = UDim2.fromOffset(height + 2, 0)
    amountLabel.Size = UDim2.new(1, -height - 14, 1, 0)
    amountLabel.TextSizeLimit.MaxTextSize = textSize
    amountLabel.Text = text
end

root:GetPropertyChangedSignal("AbsoluteSize"):Connect(refresh)
money.Changed:Connect(refresh)
player:GetAttributeChangedSignal("DataLoaded"):Connect(refresh)
refresh()
</ProtectedString>
            </Properties>
        </Item>
    </Item>
</roblox>