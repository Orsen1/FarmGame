		<Item class="LocalScript" referent="RBX167BAFB242C8409391963DCBC41BAF5C">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- Layout runs independently of inventory/remotes, including in the phone emulator.
local gui = script.Parent
local bounds = gui.ViewportBounds
local main = gui.MainFrame
local grids = {main.InnerFrame.CategoriesFrame, main.InnerFrame.ItemsFrame}
local details = main.ItemBuyFrame.Content.ItemDetails
local queued = false

local function resize()
    local size = bounds.AbsoluteSize
    if size.X <= 0 or size.Y <= 0 then return end
    local narrow = size.X < 600
    local short = size.Y < 500
    main.UISizeConstraint.MaxSize = Vector2.new(800, narrow and 720 or 560)
    main.Size = UDim2.new(0.94, 0, narrow and 0.94 or short and 0.92 or 0.88, 0)
    local compact = short and main.AbsoluteSize.X >= 500
    main:SetAttribute("LayoutProfile", narrow and "PhonePortrait" or short and "ShortLandscape" or "Desktop")
    main.HeaderFrame.Size = UDim2.new(0.5, 0, 0, compact and 44 or 56)
    main.HeaderFrame.Position = UDim2.new(0.5, 0, 0, compact and 8 or 12)
    main.CloseButton.Size = UDim2.new(0, compact and 44 or 48, 0, compact and 44 or 48)
    main.CloseButton.Position = UDim2.new(1, compact and -60 or -64, 0, compact and 8 or 16)
    for _, frame in ipairs({main.InnerFrame, main.ItemBuyFrame}) do
        frame.Position = UDim2.new(0, 15, 0, compact and 64 or 80)
        frame.Size = UDim2.new(1, -30, 1, compact and -110 or -126)
    end
    main.FooterFrame.HintLabel.Visible = main.AbsoluteSize.X >= 500
    main.FooterFrame.MoneyLabel.Size = UDim2.new(main.AbsoluteSize.X >= 500 and 0.5 or 1, 0, 1, 0)
    for _, frame in ipairs(grids) do
        -- Relative cell widths stay correct when the viewport changes.
        local twoColumns = frame.AbsoluteSize.X >= 580
        frame.UIGridLayout.FillDirectionMaxCells = twoColumns and 2 or 1
        frame.UIGridLayout.CellSize = UDim2.new(twoColumns and 0.5 or 1, twoColumns and -14 or -16, 0, frame.Name == "CategoriesFrame" and 104 or 118)
    end
    local scale = compact and 1 or math.clamp((details.Parent.AbsoluteSize.Y - 8) / 412, 0.75, 1)
    details.UIScale.Scale = scale
    local width = math.max(1, details.AbsoluteSize.X / scale)
    local column = compact and width / 2 or width
    details.Size = UDim2.new(1 / scale, -12 / scale, 0, compact and 188 or 412)
    details.ItemHeaderFrame.Size = UDim2.new(0, math.min(320, column - 64), 0, compact and 44 or 50)
    details.ItemHeaderFrame.Position = UDim2.new(compact and 0.25 or 0.5, 24, 0, 0)
    details.PriceFrame.Size = UDim2.new(0, math.min(400, column - 24), 0, 86)
    details.PriceFrame.Position = UDim2.new(compact and 0.25 or 0.5, 0, 0, compact and 56 or 68)
    details.QuantityFrame.Size = UDim2.new(0, math.min(286, column - 12), 0, 54)
    details.QuantityFrame.Position = UDim2.new(compact and 0.75 or 0.5, 0, 0, compact and 0 or 176)
    details.QuantityHintLabel.Size = UDim2.new(compact and 0.5 or 1, -100, 0, 32)
    details.QuantityHintLabel.Position = UDim2.new(compact and 0.5 or 0, 6, 0, compact and 60 or 240)
    details.MaxButton.Position = UDim2.new(1, -82, 0, compact and 60 or 240)
    details.ItemBuyButtonFrame.Size = UDim2.new(0, math.min(248, column - 12), 0, 84)
    details.ItemBuyButtonFrame.Position = UDim2.new(compact and 0.75 or 0.5, 0, 0, compact and 100 or 286)
    details.StatusLabel.Size = UDim2.new(compact and 0.5 or 1, -12, 0, 34)
    details.StatusLabel.Position = UDim2.new(0, 6, 0, compact and 150 or 378)
end

local function schedule()
    if queued then return end
    queued = true
    task.defer(function() queued = false; resize() end)
end
bounds:GetPropertyChangedSignal("AbsoluteSize"):Connect(schedule)
main:GetPropertyChangedSignal("AbsoluteSize"):Connect(schedule)
details:GetPropertyChangedSignal("AbsoluteSize"):Connect(schedule)
for _, frame in ipairs(grids) do
    frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(schedule)
end
schedule()

main:GetPropertyChangedSignal("Visible"):Connect(function() gui.Overlay.Visible = main.Visible end)
gui.Overlay.Visible = main.Visible
]]></ProtectedString>
