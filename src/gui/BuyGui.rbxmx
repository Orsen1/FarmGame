				<Item class="LocalScript" referent="RBX7A7ADF814A37433DAFD92714DDF707F0">
					<Properties>
						<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local inventory = player:WaitForChild("Inventory")

local remoteEvents = ReplicatedStorage:WaitForChild("RemoteEvents")
local buyItemEvent = remoteEvents:WaitForChild("BuyItemEvent")

local ItemDefinitions = require(ReplicatedStorage:WaitForChild("Configs"):WaitForChild("ItemDefinitions"))

local itemBuyFrame = script.Parent
local mainFrame = itemBuyFrame.Parent
local innerFrame = mainFrame:WaitForChild("InnerFrame")

local itemHeaderFrame = itemBuyFrame:WaitForChild("ItemHeaderFrame")
local itemNameLabel = itemHeaderFrame:WaitForChild("ItemNameLabel")

local priceFrame = itemBuyFrame:WaitForChild("PriceFrame")
local priceLabel = priceFrame:WaitForChild("PriceLabel")

local plusButton = itemBuyFrame:WaitForChild("PlusButton")
local minusButton = itemBuyFrame:WaitForChild("MinusButton")

local selectedAmountFrame = itemBuyFrame:WaitForChild("SelectedAmountFrame")
local selectedAmountLabel = selectedAmountFrame:WaitForChild("ItemAmountToBuyLabel")

local itemBuyButtonFrame = itemBuyFrame:WaitForChild("ItemBuyButtonFrame")
local buyButton = itemBuyButtonFrame:WaitForChild("BuyButton")
local totalPriceLabel = itemBuyButtonFrame:WaitForChild("TotalPriceLabel")

local backButton = itemBuyFrame:WaitForChild("BackButton")

local selectedAmount = 0


local function getItemAmount(itemName)
	local totalAmount = 0

	for _, slot in ipairs(inventory:GetChildren()) do
		local slotItemName = slot:FindFirstChild("ItemName")
		local slotAmount = slot:FindFirstChild("Amount")

		if slotItemName and slotAmount then
			if slotItemName.Value == itemName then
				totalAmount += slotAmount.Value
			end
		end
	end

	return totalAmount
end


local function updateItemBuyFrame()
	local itemName = itemBuyFrame:GetAttribute("ItemName")

	if not itemName then
		return
	end

	local item = ItemDefinitions[itemName]
	local price = item and item.BuyPriceCents

	if not price then
		warn("No Buy price for item:", itemName)
		return
	end

	local ownedAmount = getItemAmount(itemName)

	selectedAmount = math.clamp(selectedAmount, 0, ownedAmount)

	itemNameLabel.Text = itemName
	amountLabel.Text = tostring(ownedAmount)
	priceLabel.Text = tostring(price)

	selectedAmountLabel.Text = tostring(selectedAmount)

	local totalPrice = selectedAmount * price
	totalPriceLabel.Text = tostring(totalPrice)
end


itemBuyFrame:GetAttributeChangedSignal("ItemName"):Connect(function()
	selectedAmount = 0
	updateItemBuyFrame()
end)


plusButton.MouseButton1Click:Connect(function()
	local itemName = itemBuyFrame:GetAttribute("ItemName")

	if not itemName then
		return
	end

	local ownedAmount = getItemAmount(itemName)

	if selectedAmount < ownedAmount then
		selectedAmount += 1
	end

	updateItemBuyFrame()
end)


minusButton.MouseButton1Click:Connect(function()
	if selectedAmount > 0 then
		selectedAmount -= 1
	end

	updateItemBuyFrame()
end)


buyButton.MouseButton1Click:Connect(function()
	local itemName = itemBuyFrame:GetAttribute("ItemName")

	if not itemName then
		return
	end

	if selectedAmount <= 0 then
		return
	end

	buyItemEvent:FireServer(itemName, selectedAmount)
end)


backButton.MouseButton1Click:Connect(function()
	itemBuyFrame.Visible = false
	innerFrame.Visible = true

	selectedAmount = 0
end)


for _, slot in ipairs(inventory:GetChildren()) do
	local itemName = slot:WaitForChild("ItemName")
	local amount = slot:WaitForChild("Amount")

	itemName.Changed:Connect(updateItemBuyFrame)
	amount.Changed:Connect(updateItemBuyFrame)
end]]></ProtectedString>
