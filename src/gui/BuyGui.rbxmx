		<Item class="LocalScript" referent="RBXAAEBCC04A7BA4BECBC99DC763726171B">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local replicatedStorage = game:GetService("ReplicatedStorage")
local remoteEvents = replicatedStorage:WaitForChild("RemoteEvents")
local openBuyGuiEvent = remoteEvents:WaitForChild("OpenBuyGuiEvent")

local buyGui = script.Parent
local mainFrame = buyGui:WaitForChild("MainFrame")

local HeaderFrame = mainFrame:WaitForChild("HeaderFrame")
local closeButton = HeaderFrame:WaitForChild("CloseButton")

local innerFrame = mainFrame:WaitForChild("InnerFrame")
local itemBuyFrame = mainFrame:WaitForChild("ItemBuyFrame")


mainFrame.Visible = false


openBuyGuiEvent.OnClientEvent:Connect(function()
	mainFrame.Visible = true
	innerFrame.Visible = true
	itemBuyFrame.Visible = false
end)

closeButton.MouseButton1Click:Connect(function()
	mainFrame.Visible = false
end)


local function openItemBuyFrame(itemName)
	itemBuyFrame:SetAttribute("ItemName", itemName)
	
	innerFrame.Visible = false
	itemBuyFrame.Visible = true
	print("Selected item:", itemName)
end


for _, object in ipairs(innerFrame:GetDescendants()) do
	if object:IsA("TextButton") then
		local itemName = object:GetAttribute("ItemName")
		
		if itemName then
			object.MouseButton1Click:Connect(function()
				openItemBuyFrame(itemName)
			end)
		end
	end
end]]></ProtectedString>
