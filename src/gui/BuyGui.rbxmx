		<Item class="LocalScript" referent="RBX76B88542105B4356876C297C58EE34A1">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- Reads the existing ItemDefinitions and uses the existing shop remotes.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local gui = script.Parent
local main = gui.MainFrame
local catalogue = main.InnerFrame
local categories = catalogue.CategoriesFrame
local items = catalogue.ItemsFrame
local purchase = main.ItemBuyFrame
local details = purchase.Content.ItemDetails
local quantity = details.QuantityFrame
local action = details.ItemBuyButtonFrame
local header = main.HeaderFrame.TextLabel
local template = gui.Templates.ItemCardTemplate
main.Visible = false

local player = Players.LocalPlayer
local inventory = player:WaitForChild("Inventory")
local money = player:WaitForChild("PlayerData"):WaitForChild("MoneyCents")
local remotes = ReplicatedStorage:WaitForChild("RemoteEvents")
local openEvent = remotes:WaitForChild("OpenBuyGuiEvent")
local buyEvent = remotes:WaitForChild("BuyItemEvent")
local definitions = require(ReplicatedStorage:WaitForChild("Configs"):WaitForChild("ItemDefinitions"))

local GREEN = Color3.fromRGB(85, 155, 55)
local MUTED = Color3.fromRGB(125, 75, 35)
local RED = Color3.fromRGB(180, 70, 55)
local DISABLED = Color3.fromRGB(194, 165, 108)
local MAX_INTEGER = 9007199254740991
local cards = {}
local selectedId = nil
local selectedAmount = 0
local activeCategory = nil
local pending = nil
local requestNumber = 0
local message = ""
local messageColor = MUTED
local categoryNames = {"Seeds", "Furniture", "Animals", "Equipment"}

local function formatMoney(cents)
    return string.format("$%.2f", cents / 100)
end

local function categoryOf(item)
    for _, category in ipairs(categoryNames) do
        if item.ShopCategory == category then return category end
    end
    if item.Type == "Seed" then return "Seeds" end
    if item.Type == "Furniture" then return "Furniture" end
    if item.Type == "Animal" then return "Animals" end
    return "Equipment"
end

local function itemName(id, item)
    local name = item.DisplayName
    if typeof(name) == "string" and name ~= "" and not name:find("[\128-\255]") then return name end
    return (id:gsub("(%l)(%u)", "%1 %2"):gsub("_", " "))
end

local function validPrice(price)
    return typeof(price) == "number" and price >= 0
        and price <= MAX_INTEGER and price % 1 == 0
end

local function maximumAmount(price)
    if price == 0 then return MAX_INTEGER end
    return math.min(MAX_INTEGER, math.floor(math.max(0, money.Value) / price))
end

local function inventoryInfo(id)
    local owned, room = 0, false
    for _, slot in ipairs(inventory:GetChildren()) do
        local name = slot:FindFirstChild("ItemName")
        local amount = slot:FindFirstChild("Amount")
        if name and amount then
            if name.Value == id then owned = owned + amount.Value end
            if name.Value == "" or name.Value == id then room = true end
        end
    end
    return owned, room
end

local function enableButton(button, enabled, color)
    button.Interactable = enabled
    button.Selectable = enabled
    button.AutoButtonColor = enabled
    button.BackgroundColor3 = enabled and color or DISABLED
end

local function refresh()
    main.FooterFrame.MoneyLabel.Text = "Balance: " .. formatMoney(money.Value)
    for id, card in pairs(cards) do
        local owned = inventoryInfo(id)
        card.OwnedLabel.Text = "You have: " .. tostring(owned)
    end
    if not selectedId then return end

    local item = definitions[selectedId]
    local price = item.BuyPriceCents
    local maximum = maximumAmount(price)
    local owned, room = inventoryInfo(selectedId)
    selectedAmount = math.clamp(selectedAmount, 0, maximum)
    details.ItemHeaderFrame.ItemNameLabel.Text = itemName(selectedId, item)
    details.PriceFrame.OwnedAmountLabel.Text = tostring(owned)
    details.PriceFrame.PriceLabel.Text = formatMoney(price)
    quantity.SelectedAmountFrame.ItemAmountToBuyLabel.Text = tostring(selectedAmount)
    action.TotalPriceLabel.Text = formatMoney(price * selectedAmount)
    details.QuantityHintLabel.Text = "Can buy: " .. tostring(maximum)
    enableButton(quantity.MinusButton, not pending and selectedAmount > 0, RED)
    enableButton(quantity.PlusButton, not pending and room and selectedAmount < maximum, RED)
    enableButton(details.MaxButton, not pending and room and maximum > 0, GREEN)
    enableButton(action.BuyButton, not pending and room and selectedAmount > 0, GREEN)
    action.BuyButton.Text = pending and "Buying..." or "Buy"

    local text, color = message, messageColor
    if pending then text, color = "Waiting for the server...", MUTED
    elseif text ~= "" then -- Keep the latest server response visible.
    elseif not room then text, color = "Inventory full. Free a slot to buy this item.", RED
    elseif maximum == 0 then text, color = "Not enough money.", RED
    else text, color = "Choose an amount, then press Buy.", MUTED end
    details.StatusLabel.Text = text
    details.StatusLabel.TextColor3 = color
end

local function showCatalogue(category)
    activeCategory = category
    selectedId = nil
    purchase:SetAttribute("ItemName", nil)
    catalogue.Visible = true
    purchase.Visible = false
    categories.Visible = category == nil
    items.Visible = category ~= nil
    catalogue.CategoryBackButton.Visible = category ~= nil
    catalogue.IntroLabel.Text = category or "Choose a category"
    header.Text = "What to buy?"
    local count = 0
    for _, card in ipairs(items:GetChildren()) do
        if card:IsA("Frame") then
            card.Visible = card:GetAttribute("ShopCategory") == category
            if card.Visible then count = count + 1 end
        end
    end
    catalogue.EmptyLabel.Visible = category ~= nil and count == 0
    items.CanvasPosition = Vector2.new(0, 0)
    message = ""
    refresh()
end

local function selectItem(id)
    selectedId = id
    purchase:SetAttribute("ItemName", id)
    selectedAmount = maximumAmount(definitions[id].BuyPriceCents) > 0 and 1 or 0
    message = ""
    catalogue.Visible = false
    purchase.Visible = true
    purchase.Content.CanvasPosition = Vector2.new(0, 0)
    refresh()
end

local ids = {}
for id, item in pairs(definitions) do
    if typeof(id) == "string" and typeof(item) == "table" and validPrice(item.BuyPriceCents) then
        table.insert(ids, id)
    end
end
table.sort(ids, function(a, b)
    local orderA = definitions[a].SortOrder or math.huge
    local orderB = definitions[b].SortOrder or math.huge
    if orderA ~= orderB then return orderA < orderB end
    return a < b
end)

local stocked = {}
for order, id in ipairs(ids) do
    local item = definitions[id]
    local category = categoryOf(item)
    local card = template:Clone()
    card.Name = id .. "Card"
    card.LayoutOrder = order
    card:SetAttribute("ItemName", id)
    card:SetAttribute("ShopCategory", category)
    card.SelectButton.Text = itemName(id, item)
	card.PriceLabel.Text = formatMoney(item.BuyPriceCents) .. " / each"
    card.SelectButton.Activated:Connect(function() selectItem(id) end)
    card.Visible = false
    card.Parent = items
    cards[id] = card
    stocked[category] = true
end

-- Placeholders are display only; they never send purchase requests.
local futureStock = {
    Furniture = {"Chair", "Table", "Cabinet", "Bed"},
    Animals = {"Chicken", "Cow", "Sheep", "Pig"},
    Equipment = {"Watering can", "Tractor", "Sprinkler", "Tools"},
}
for category, names in pairs(futureStock) do
    if not stocked[category] then
        for order, name in ipairs(names) do
            local card = template:Clone()
            card.Name = category .. "Placeholder" .. order
            card.LayoutOrder = order
            card:SetAttribute("ShopCategory", category)
            card.SelectButton.Text = name
            enableButton(card.SelectButton, false, GREEN)
            card.PriceLabel.Text = "Coming soon"
            card.OwnedLabel.Text = ""
            card.Visible = false
            card.Parent = items
        end
    end
end
for _, category in ipairs(categoryNames) do
    categories[category .. "Frame"].SelectButton.Activated:Connect(function()
        showCatalogue(category)
    end)
end
catalogue.CategoryBackButton.Activated:Connect(function() showCatalogue(nil) end)
details.BackButton.Activated:Connect(function() showCatalogue(activeCategory) end)

local function changeAmount(amount)
    if not selectedId or pending then return end
    selectedAmount = amount
    message = ""
    refresh()
end
quantity.PlusButton.Activated:Connect(function() changeAmount(selectedAmount + 1) end)
quantity.MinusButton.Activated:Connect(function() changeAmount(selectedAmount - 1) end)
details.MaxButton.Activated:Connect(function()
    if selectedId then changeAmount(maximumAmount(definitions[selectedId].BuyPriceCents)) end
end)

action.BuyButton.Activated:Connect(function()
    refresh()
    if not selectedId or pending or not action.BuyButton.Interactable then return end
    requestNumber = requestNumber + 1
    local request = {Id = tostring(requestNumber), ItemName = selectedId, Amount = selectedAmount}
    pending = request
    message = ""
    refresh()
    buyEvent:FireServer(request.ItemName, request.Amount, request.Id)
    task.delay(8, function()
        if pending ~= request then return end
        pending = nil
        message = "No confirmation. Check your balance and inventory."
        messageColor = RED
        refresh()
    end)
end)

local errors = {
    InventoryFull = "Inventory full. Free a slot first.",
    InventoryNotReady = "Inventory is loading. Try again shortly.",
    NotEnoughMoneyOrDataNotReady = "Not enough money, or data is still loading.",
    NotEnoughMoney = "Not enough money.",
    ItemCannotBeBought = "This item cannot be bought right now.",
    InvalidItem = "Item not found.",
    InvalidAmount = "Invalid amount.",
    InvalidItemOrAmount = "Invalid item or amount.",
    AmountTooLarge = "Too many items in one purchase.",
    RateLimited = "Please wait a moment before buying again.",
    InternalError = "Purchase not confirmed. Check your balance and inventory.",
}
buyEvent.OnClientEvent:Connect(function(result)
    if typeof(result) ~= "table" or not pending or result.RequestId ~= pending.Id then return end
    local request = pending
    pending = nil
    if selectedId == request.ItemName then
        if result.Success == true then
            selectedAmount = 0
            message = "Bought " .. request.Amount .. "! Added to your inventory."
            messageColor = GREEN
        else
            message = errors[result.Reason] or "Purchase failed. Please try again."
            messageColor = RED
        end
    end
    refresh()
end)

-- Follow existing and newly created inventory values without rebuilding the UI.
local watched = {}
local function watch(value)
    if value:IsA("ValueBase") and not watched[value] then
        watched[value] = value.Changed:Connect(refresh)
    end
end
for _, value in ipairs(inventory:GetDescendants()) do watch(value) end
inventory.DescendantAdded:Connect(function(value) watch(value); refresh() end)
inventory.DescendantRemoving:Connect(function(value)
    if watched[value] then watched[value]:Disconnect(); watched[value] = nil end
    task.defer(refresh)
end)
money.Changed:Connect(refresh)

local function closeShop()
    main.Visible = false
end
main.CloseButton.Activated:Connect(closeShop)
openEvent.OnClientEvent:Connect(function()
    showCatalogue(nil)
    main.Visible = true
end)
UserInputService.InputBegan:Connect(function(input)
    if not main.Visible or UserInputService:GetFocusedTextBox() then return end
    if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
        if purchase.Visible then showCatalogue(activeCategory)
        elseif activeCategory then showCatalogue(nil)
        else closeShop() end
    end
end)
refresh()
]]></ProtectedString>
