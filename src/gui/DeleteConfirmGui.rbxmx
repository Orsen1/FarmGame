    <Item class="LocalScript" referent="RBX00000000000000000000000000000042">
      <Properties>
        <string name="Name">ResponsiveLayout</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source">-- Layout is independent of inventory and server events.
local gui = script.Parent
local dialog = gui:WaitForChild("Dialog")
local scale = dialog:WaitForChild("UIScale")
local title = dialog:WaitForChild("Title")
local message = dialog:WaitForChild("Message")
local warning = dialog:WaitForChild("Warning")
local cancel = dialog:WaitForChild("CancelButton")
local remove = dialog:WaitForChild("RemoveButton")

local function resize()
    local size = gui.AbsoluteSize
    if size.X &lt;= 0 or size.Y &lt;= 0 then
        return
    end

    local width = math.min(460, math.max(160, size.X - 28))
    local compact = size.Y &lt; 340
    local narrow = width &lt; 340
    local height = compact and 244 or (narrow and 316 or 296)

    dialog.Size = UDim2.fromOffset(width, height)
    dialog.Position = UDim2.fromScale(0.5, 0.5)
    scale.Scale = math.min(1, (size.Y - 24) / height, (size.X - 20) / width)

    title.Position = UDim2.fromOffset(16, 16)
    title.Size = UDim2.new(1, -32, 0, compact and 44 or 54)

    message.Position = UDim2.fromOffset(24, compact and 72 or 90)
    message.Size = UDim2.new(1, -48, 0, compact and 80 or (narrow and 112 or 92))

    warning.Visible = not compact
    warning.Position = UDim2.fromOffset(24, narrow and 210 or 190)
    warning.Size = UDim2.new(1, -48, 0, 22)

    cancel.Position = UDim2.new(0, 20, 1, -70)
    remove.Position = UDim2.new(0.5, 6, 1, -70)
    cancel.Size = UDim2.new(0.5, -26, 0, 50)
    remove.Size = UDim2.new(0.5, -26, 0, 50)
end

gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize)
gui:GetPropertyChangedSignal("Enabled"):Connect(resize)
resize()
</ProtectedString>
      </Properties>
    </Item>
    <Item class="LocalScript" referent="RBX00000000000000000000000000000043">
      <Properties>
        <string name="Name">RemovalController</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
local inventory = player:WaitForChild("Inventory")
local event = ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("RemoveObjectEvent")
local gui = script.Parent
local dialog = gui:WaitForChild("Dialog")
local message = dialog:WaitForChild("Message")
local confirm = dialog:WaitForChild("RemoveButton")
local cancel = dialog:WaitForChild("CancelButton")

local target
local targetConnection
local pending = false

gui.Enabled = false
StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)

local function closeDialog()
    gui.Enabled = false
    target = nil

    if targetConnection then
        targetConnection:Disconnect()
        targetConnection = nil
    end
end

local function hasShovel()
    local character = player.Character
    local tool = character and character:FindFirstChild("EquippedItem")
    local slotNumber = player:GetAttribute("SelectedSlot") or 1
    local slot = inventory:FindFirstChild("Slot" .. slotNumber)

    return tool and tool:IsA("Tool")
        and tool:GetAttribute("ItemName") == "Shovel"
        and slot and slot.ItemName.Value == "Shovel" and slot.Amount.Value &gt; 0
end

ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
    if who ~= player or pending or gui.Enabled
        or prompt.Name ~= "GardenBedPrompt"
        or player:GetAttribute("DataLoaded") ~= true
        or not hasShovel() then
        return
    end

    local bed = prompt:FindFirstAncestorWhichIsA("Model")

    if not bed or bed:GetAttribute("OwnerUserId") ~= player.UserId then
        return
    end

    target = bed
    message.Text = "The garden bed and any crops will be permanently lost."
    gui.Enabled = true

    targetConnection = bed.AncestryChanged:Connect(function()
        if not bed:IsDescendantOf(workspace) then
            closeDialog()
        end
    end)
end)

confirm.Activated:Connect(function()
    if pending or not target then
        return
    end

    if not hasShovel() then
        closeDialog()
        return
    end

    pending = true
    confirm.Interactable = false
    cancel.Interactable = false
    confirm.Text = "Removing..."
    event:FireServer(target)
end)

cancel.Activated:Connect(function()
    if not pending then
        closeDialog()
    end
end)

event.OnClientEvent:Connect(function(success, text)
    pending = false
    confirm.Interactable = true
    cancel.Interactable = true
    confirm.Text = "Remove"

    if success then
        closeDialog()
    elseif gui.Enabled then
        message.Text = text
    end
end)

player:GetAttributeChangedSignal("SelectedSlot"):Connect(closeDialog)
player:GetAttributeChangedSignal("DataLoaded"):Connect(function()
    if player:GetAttribute("DataLoaded") ~= true then
        closeDialog()
    end
end)

player.CharacterRemoving:Connect(closeDialog)

UserInputService.InputBegan:Connect(function(input)
    if gui.Enabled and not pending and (input.KeyCode == Enum.KeyCode.Escape
        or input.KeyCode == Enum.KeyCode.ButtonB) then
        closeDialog()
    end
end)
</ProtectedString>
      </Properties>
    </Item>
  </Item>
</roblox>