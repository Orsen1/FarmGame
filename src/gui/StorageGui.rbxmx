    <Item class="LocalScript" referent="RBX_StorageUI_211">
      <Properties>
        <string name="Name">StorageController</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local gui = script.Parent
local panel = gui:WaitForChild("Panel")
local grid = panel:WaitForChild("Grid")
local layout = grid:WaitForChild("UIGridLayout")
local title = panel:WaitForChild("Title")
local message = panel:WaitForChild("MessageLabel")
local closeButton = panel:WaitForChild("CloseButton")
local hotbar = player.PlayerGui:WaitForChild("InventoryGui"):WaitForChild("HotbarFrame")
local referenceSlot = hotbar:WaitForChild("Slot1")
local plots = workspace:WaitForChild("Plots")

local ItemDefinitions = require(ReplicatedStorage:WaitForChild("Configs"):WaitForChild("ItemDefinitions"))
local PlacementController = require(ReplicatedStorage:WaitForChild("PlacementScripts"):WaitForChild("PlacementController"))

local activePrompt = nil
local pendingPrompt = nil
local slotConnections = {}
local elapsed = 0
local storageEvent = ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("StorageEvent")
local storageObject = gui:FindFirstChild("StorageObject") or Instance.new("ObjectValue")
storageObject.Name = "StorageObject"
storageObject.Parent = gui

-- Берём размер ячеек из хотбара; на небольших экранах оставляем прокрутку.
local function updateLayout()
    local viewport = gui.AbsoluteSize
    if viewport.X &lt;= 0 or viewport.Y &lt;= 0 then
        return
    end

    local compact = viewport.Y &lt; 480
    local columns
    if viewport.X &gt;= 1050 or (compact and viewport.X &gt;= 680) then
        columns = 8
    elseif viewport.X &gt;= 620 then
        columns = 6
    else
        columns = 4
    end

    local rows = 24 / columns
    local padding = compact and 14 or 20
    local gap = compact and 8 or 12
    local header = compact and 54 or 68
    local footer = compact and 28 or 38
    local maxWidth = math.min(1040, viewport.X - 28)
    local bottom = math.min(viewport.Y - 14, hotbar.AbsolutePosition.Y - 16)
    local targetCell = referenceSlot.AbsoluteSize.X

    -- Удобная область нажатия на телефоне, даже если хотбар очень маленький.
    if UserInputService.TouchEnabled then
        targetCell = math.max(56, targetCell)
        if compact then
            targetCell = math.min(64, targetCell)
        end
    end

    local cellWidth = (maxWidth - padding * 2 - 16 - gap * (columns - 1)) / columns
    local cell = math.max(1, math.floor(math.min(targetCell, cellWidth) + 0.001))
    local gridWidth = cell * columns + gap * (columns - 1)
    local gridHeight = cell * rows + gap * (rows - 1)
    local canvasHeight = gridHeight + 8
    local availableHeight = math.max(1, bottom - 14 - header - footer)
    local visibleHeight = math.min(canvasHeight, availableHeight)
    local height = header + visibleHeight + footer
    local panelBottom = math.min(bottom, viewport.Y * 0.46 + height / 2)

    panel.Size = UDim2.fromOffset(gridWidth + padding * 2 + 16, height)
    panel.Position = UDim2.new(0.5, 0, 0, panelBottom)
    grid.Size = UDim2.fromOffset(gridWidth + 16, visibleHeight)
    grid.Position = UDim2.fromOffset(padding, header)
    grid.CanvasSize = UDim2.fromOffset(0, canvasHeight)
    grid.ScrollingDirection = Enum.ScrollingDirection.Y
    grid.ScrollBarThickness = canvasHeight &gt; visibleHeight and 6 or 0
    grid.CanvasPosition = Vector2.new(0, math.min(grid.CanvasPosition.Y, canvasHeight - visibleHeight))

    title.Position = UDim2.fromOffset(padding + 2, compact and 10 or 16)
    title.Size = UDim2.new(1, -padding * 2 - 64, 0, 34)
    title.TextSize = compact and 25 or 30
    closeButton.Position = UDim2.new(1, -padding - 44, 0, compact and 5 or 12)
    message.Position = UDim2.new(0, padding + 4, 1, -footer)
    message.Size = UDim2.new(1, -padding * 2 - 8, 0, footer)
    message.TextSize = compact and 12 or 14
    message.Text = UserInputService.TouchEnabled and "24 slots" or "24 slots  |  Q / Esc to close"
    layout.FillDirectionMaxCells = columns
    layout.CellSize = UDim2.fromOffset(cell, cell)
    layout.CellPadding = UDim2.fromOffset(gap, gap)
end

local function getStorageObject(prompt)
    if not prompt or not prompt:IsDescendantOf(plots) then
        return nil
    end

    local plotName = player:GetAttribute("PlotName")
    local plot = plotName and plots:FindFirstChild(plotName)
    local objects = plot and plot:FindFirstChild("PlacedObjects")

    if not objects or plot:GetAttribute("OwnerUserId") ~= player.UserId then
        return nil
    end

    local object = prompt.Parent
    while object and object.Parent ~= objects do
        object = object.Parent
    end

    if not object or not object:IsA("Model")
        or object:GetAttribute("OwnerUserId") ~= player.UserId then
        return nil
    end

    local itemName = object:GetAttribute("ItemName") or object.Name
    local definition = ItemDefinitions[itemName]

    if not definition or definition.Placeable ~= true or definition.StorageSlots ~= 24 then
        return nil
    end

    return object, definition
end

local function canUse(prompt)
    if player:GetAttribute("DataLoaded") ~= true
        or player:GetAttribute("ProductionMode") == true then
        return false
    end

    local object = getStorageObject(prompt)
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local attachment = prompt and prompt.Parent

    if not object or not humanoid or humanoid.Health &lt;= 0 or not root
        or not attachment or not attachment:IsA("Attachment") then
        return false
    end

    return (root.Position - attachment.WorldPosition).Magnitude &lt;= prompt.MaxActivationDistance
end

local function closeStorage()
    activePrompt = nil
    pendingPrompt = nil
    storageObject.Value = nil
    for _, connection in ipairs(slotConnections) do
        connection:Disconnect()
    end
    slotConnections = {}
    panel.Visible = false
    player:SetAttribute("StorageOpen", false)
end

local function openStorage(prompt)
    if not canUse(prompt) then
        return
    end

    local object = getStorageObject(prompt)
    pendingPrompt = prompt
    storageEvent:FireServer(object)
end

storageEvent.OnClientEvent:Connect(function(object, success, reason)
    local prompt = pendingPrompt
    if not prompt or getStorageObject(prompt) ~= object then
        return
    end
    if not success then
        pendingPrompt = nil
        warn("[STORAGE]", reason)
        return
    end

    -- Содержимое папки может реплицироваться чуть позже ответа сервера.
    local folder = object:WaitForChild("StorageInventory", 5)
    local rows = {}
    if folder then
        for index = 1, 24 do
            local slot = folder:WaitForChild("Slot" .. index, 5)
            local name = slot and slot:WaitForChild("ItemName", 5)
            local amount = slot and slot:WaitForChild("Amount", 5)
            if not name or not amount then
                break
            end
            rows[index] = {Name = name, Amount = amount}
        end
    end
    if pendingPrompt ~= prompt then
        return
    end
    if #rows ~= 24 or not canUse(prompt) then
        closeStorage()
        warn("[STORAGE] Storage inventory is not ready")
        return
    end

    for _, connection in ipairs(slotConnections) do
        connection:Disconnect()
    end
    slotConnections = {}
    for index, row in ipairs(rows) do
        local guiSlot = grid:FindFirstChild("Slot" .. index)
        local function refresh()
            local definition = ItemDefinitions[row.Name.Value]
            local icon = definition and definition.Icon
            local occupied = row.Name.Value ~= "" and row.Amount.Value &gt; 0
            guiSlot.ItemIcon.Image = occupied and typeof(icon) == "string" and icon or ""
            guiSlot.AmountText.Text = occupied and tostring(row.Amount.Value) or ""
        end
        table.insert(slotConnections, row.Name.Changed:Connect(refresh))
        table.insert(slotConnections, row.Amount.Changed:Connect(refresh))
        refresh()
    end

    pendingPrompt = nil
    activePrompt = prompt
    storageObject.Value = object
    PlacementController.cancelPlacement()
    title.Text = "Warehouse"
    updateLayout()
    grid.CanvasPosition = Vector2.new(0, 0)
    panel.Visible = true
    player:SetAttribute("StorageOpen", true)
end)

ProximityPromptService.PromptTriggered:Connect(function(prompt, triggeringPlayer)
    if triggeringPlayer and triggeringPlayer ~= player then
        return
    end

    if prompt.Name == "StoragePrompt" then
        openStorage(prompt)
    end
end)

closeButton.Activated:Connect(closeStorage)

UserInputService.InputBegan:Connect(function(input)
    if (activePrompt or pendingPrompt) and not UserInputService:GetFocusedTextBox()
        and (input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.Escape) then
        closeStorage()
    end
end)

-- Закрываем окно при смерти, уходе от коробок или удалении склада.
RunService.Heartbeat:Connect(function(deltaTime)
    elapsed = elapsed + deltaTime
    if elapsed &lt; 0.25 then
        return
    end
    elapsed = 0

    if activePrompt and not canUse(activePrompt) then
        closeStorage()
    end
end)

gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateLayout)
hotbar:GetPropertyChangedSignal("AbsolutePosition"):Connect(updateLayout)
hotbar:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateLayout)
referenceSlot:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateLayout)
UserInputService:GetPropertyChangedSignal("TouchEnabled"):Connect(updateLayout)
player.CharacterRemoving:Connect(closeStorage)
player:GetAttributeChangedSignal("ProductionMode"):Connect(function()
    if player:GetAttribute("ProductionMode") == true then
        closeStorage()
    end
end)

closeStorage()
task.defer(updateLayout)
</ProtectedString>
      </Properties>
    </Item>
  </Item>
</roblox>